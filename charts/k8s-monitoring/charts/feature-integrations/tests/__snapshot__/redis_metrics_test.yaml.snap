should create the Redis config:
  1: |
    |-
      declare "redis_integration" {
        argument "metrics_destinations" {
          comment = "Must be a list of metric destinations where collected metrics should be forwarded to"
        }


        remote.kubernetes.secret "my_redis" {
          name      = "my-redis-release-name-feature-integrations"
          namespace = "NAMESPACE"
        }

        prometheus.exporter.redis "my_redis" {
          redis_addr = "my-redis.redis.svc:6379"
          redis_password = convert.nonsensitive(remote.kubernetes.secret.my_redis.data["password"])
        }
        prometheus.scrape "my_redis" {
          targets    = prometheus.exporter.redis.my_redis.targets
          job_name   = "integration/redis"
          forward_to = [prometheus.relabel.my_redis.receiver]
        }

        prometheus.relabel "my_redis" {
          max_cache_size = 100000
          rule {
            target_label = "instance"
            replacement = "my-redis"
          }
          forward_to = argument.metrics_destinations.value
        }
      }
works when referencing an external Redis Secret:
  1: |
    |-
      declare "redis_integration" {
        argument "metrics_destinations" {
          comment = "Must be a list of metric destinations where collected metrics should be forwarded to"
        }


        remote.kubernetes.secret "test_redis" {
          name      = "test-redis-secret"
          namespace = "redis"
        }

        prometheus.exporter.redis "test_redis" {
          redis_addr = "test-redis.redis.svc:6379"
          redis_password = convert.nonsensitive(remote.kubernetes.secret.test_redis.data["redis-password"])
        }
        prometheus.scrape "test_redis" {
          targets    = prometheus.exporter.redis.test_redis.targets
          job_name   = "integration/redis"
          forward_to = [prometheus.relabel.test_redis.receiver]
        }

        prometheus.relabel "test_redis" {
          max_cache_size = 100000
          rule {
            target_label = "instance"
            replacement = "test-redis"
          }
          forward_to = argument.metrics_destinations.value
        }
      }
works with metrics disabled (no exporter address required):
  1: |
    |-
      declare "redis_integration" {
        argument "metrics_destinations" {
          comment = "Must be a list of metric destinations where collected metrics should be forwarded to"
        }

      }
works with multiple Redis Instances:
  1: |
    |-
      declare "redis_integration" {
        argument "metrics_destinations" {
          comment = "Must be a list of metric destinations where collected metrics should be forwarded to"
        }

        prometheus.exporter.redis "test_redis" {
          redis_addr = "redis.test.svc:6379"
        }
        prometheus.scrape "test_redis" {
          targets    = prometheus.exporter.redis.test_redis.targets
          job_name   = "integration/redis"
          forward_to = [prometheus.relabel.test_redis.receiver]
        }

        prometheus.relabel "test_redis" {
          max_cache_size = 100000
          rule {
            target_label = "instance"
            replacement = "test-redis"
          }
          forward_to = argument.metrics_destinations.value
        }


        remote.kubernetes.secret "staging_redis" {
          name      = "staging-redis-release-name-feature-integrations"
          namespace = "NAMESPACE"
        }

        prometheus.exporter.redis "staging_redis" {
          redis_addr = "redis.staging.svc:6379"
          redis_password = convert.nonsensitive(remote.kubernetes.secret.staging_redis.data["password"])
        }
        prometheus.scrape "staging_redis" {
          targets    = prometheus.exporter.redis.staging_redis.targets
          job_name   = "integration/redis"
          forward_to = [prometheus.relabel.staging_redis.receiver]
        }

        prometheus.relabel "staging_redis" {
          max_cache_size = 100000
          rule {
            target_label = "instance"
            replacement = "staging-redis"
          }
          forward_to = argument.metrics_destinations.value
        }


        remote.kubernetes.secret "prod_redis" {
          name      = "prod-redis-release-name-feature-integrations"
          namespace = "NAMESPACE"
        }

        prometheus.exporter.redis "prod_redis" {
          redis_addr = "redis.prod.svc:6379"
          redis_password = convert.nonsensitive(remote.kubernetes.secret.prod_redis.data["password"])
        }
        prometheus.scrape "prod_redis" {
          targets    = prometheus.exporter.redis.prod_redis.targets
          job_name   = "integration/redis"
          forward_to = [prometheus.relabel.prod_redis.receiver]
        }

        prometheus.relabel "prod_redis" {
          max_cache_size = 100000
          rule {
            target_label = "instance"
            replacement = "prod-redis"
          }
          forward_to = argument.metrics_destinations.value
        }
      }
