should create the PostgreSQL config:
  1: |
    |-
      declare "postgres_integration" {
        argument "metrics_destinations" {
          comment = "Must be a list of metric destinations where collected metrics should be forwarded to"
        }


        remote.kubernetes.secret "my_postgres" {
          name      = "my-postgres-release-name-feature-integrations"
          namespace = "NAMESPACE"
        }

        prometheus.exporter.postgres "my_postgres" {
          data_source_names = [string.format("postgresql://%s:%s@%s",
            convert.nonsensitive(remote.kubernetes.secret.my_postgres.data["username"]),
            convert.nonsensitive(remote.kubernetes.secret.my_postgres.data["password"]),
            "my-postgres.postgresql.svc:5432"
          )]
        }
        prometheus.scrape "my_postgres" {
          targets    = prometheus.exporter.postgres.my_postgres.targets
          job_name   = "integration/postgres"
          forward_to = [prometheus.relabel.my_postgres.receiver]
        }

        prometheus.relabel "my_postgres" {
          max_cache_size = 100000
          rule {
            target_label = "instance"
            replacement = "my-postgres"
          }
          forward_to = argument.metrics_destinations.value
        }
      }
works when referencing an external PostgreSQL Secret:
  1: |
    |-
      declare "postgres_integration" {
        argument "metrics_destinations" {
          comment = "Must be a list of metric destinations where collected metrics should be forwarded to"
        }


        remote.kubernetes.secret "test_postgres" {
          name      = "test-postgres-secret"
          namespace = "postgresql"
        }

        prometheus.exporter.postgres "test_postgres" {
          data_source_names = [string.format("postgresql://%s:%s@%s",
            sys.env(PG_USER),
            convert.nonsensitive(remote.kubernetes.secret.test_postgres.data["postgres-password"]),
            "test-postgres.postgresql.svc:5432"
          )]
        }
        prometheus.scrape "test_postgres" {
          targets    = prometheus.exporter.postgres.test_postgres.targets
          job_name   = "integration/postgres"
          forward_to = [prometheus.relabel.test_postgres.receiver]
        }

        prometheus.relabel "test_postgres" {
          max_cache_size = 100000
          rule {
            target_label = "instance"
            replacement = "test-postgres"
          }
          forward_to = argument.metrics_destinations.value
        }
      }
works with multiple PostgreSQL Instances:
  1: |
    |-
      declare "postgres_integration" {
        argument "metrics_destinations" {
          comment = "Must be a list of metric destinations where collected metrics should be forwarded to"
        }

        prometheus.exporter.postgres "test_pg" {
          data_source_names = [string.format("postgresql://%s:%s@%s",
            ,
            ,
            "postgres.test.svc:5432"
          )]
        }
        prometheus.scrape "test_pg" {
          targets    = prometheus.exporter.postgres.test_pg.targets
          job_name   = "integration/postgres"
          forward_to = [prometheus.relabel.test_pg.receiver]
        }

        prometheus.relabel "test_pg" {
          max_cache_size = 100000
          rule {
            target_label = "instance"
            replacement = "test-pg"
          }
          forward_to = argument.metrics_destinations.value
        }


        remote.kubernetes.secret "staging_pg" {
          name      = "staging-pg-release-name-feature-integrations"
          namespace = "NAMESPACE"
        }

        prometheus.exporter.postgres "staging_pg" {
          data_source_names = [string.format("postgresql://%s:%s@%s",
            convert.nonsensitive(remote.kubernetes.secret.staging_pg.data["username"]),
            convert.nonsensitive(remote.kubernetes.secret.staging_pg.data["password"]),
            "postgres.staging.svc:5432"
          )]
        }
        prometheus.scrape "staging_pg" {
          targets    = prometheus.exporter.postgres.staging_pg.targets
          job_name   = "integration/postgres"
          forward_to = [prometheus.relabel.staging_pg.receiver]
        }

        prometheus.relabel "staging_pg" {
          max_cache_size = 100000
          rule {
            target_label = "instance"
            replacement = "staging-pg"
          }
          forward_to = argument.metrics_destinations.value
        }


        remote.kubernetes.secret "prod_pg" {
          name      = "prod-pg-release-name-feature-integrations"
          namespace = "NAMESPACE"
        }

        prometheus.exporter.postgres "prod_pg" {
          data_source_names = [string.format("postgresql://%s:%s@%s",
            convert.nonsensitive(remote.kubernetes.secret.prod_pg.data["username"]),
            convert.nonsensitive(remote.kubernetes.secret.prod_pg.data["password"]),
            "postgres.prod.svc:5432"
          )]
        }
        prometheus.scrape "prod_pg" {
          targets    = prometheus.exporter.postgres.prod_pg.targets
          job_name   = "integration/postgres"
          forward_to = [prometheus.relabel.prod_pg.receiver]
        }

        prometheus.relabel "prod_pg" {
          max_cache_size = 100000
          rule {
            target_label = "instance"
            replacement = "prod-pg"
          }
          forward_to = argument.metrics_destinations.value
        }
      }
