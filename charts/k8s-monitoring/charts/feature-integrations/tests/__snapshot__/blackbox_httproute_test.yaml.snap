should create blackbox config with HTTPRoute discovery enabled:
  1: |
    |-
      declare "blackbox_integration" {
        argument "metrics_destinations" {
          comment = "Must be a list of metric destinations where collected metrics should be forwarded to"
        }


        // Create blackbox exporter
        prometheus.exporter.blackbox "httproute_prober" {
          config_yaml = "modules:\n  http_2xx:\n    prober: http\n    timeout: 5s\n    http:\n      valid_http_versions: [\"HTTP/1.1\", \"HTTP/2.0\"]\n      valid_status_codes: []\n      method: GET\n"
        }
        // Discover HTTPRoute resources
        discovery.kubernetes "httproutes_httproute_prober" {
          role = "httproute"
          namespaces {
            names = ["production","staging"]
          }
          selectors {
            role = "httproute"
            label = "gateway=external"
          }
        }

        // Process discovered HTTPRoutes
        discovery.relabel "httproutes_httproute_prober" {
          targets = discovery.kubernetes.httproutes_httproute_prober.targets

          // Keep only targets that have hostnames defined
          rule {
            source_labels = ["__meta_kubernetes_httproute_spec_hostnames"]
            regex = "\\[\\]"
            action = "drop"
          }

          // Extract hostnames array
          rule {
            source_labels = ["__meta_kubernetes_httproute_spec_hostnames"]
            regex = "\\[([^\\]]+)\\]"
            target_label = "__tmp_hostnames"
          }

          // Extract first hostname and create target URL
          // TODO: To support multiple hostnames per HTTPRoute, consider using multiple discovery instances
          rule {
            source_labels = ["__tmp_hostnames"]
            regex = "([^,\\s]+)"
            target_label = "__param_target"
            replacement = "https://${1}/health"
          }

          // Set module
          rule {
            target_label = "__param_module"
            replacement = "http_2xx"
          }

          // Set address to blackbox exporter
          rule {
            target_label = "__address__"
            replacement = "127.0.0.1:9115"
          }

          // Add metadata labels
          rule {
            source_labels = ["__meta_kubernetes_httproute_namespace"]
            target_label = "namespace"
          }

          rule {
            source_labels = ["__meta_kubernetes_httproute_name"]
            target_label = "httproute"
          }

          // Add target label for clarity
          rule {
            source_labels = ["__param_target"]
            target_label = "target"
          }
        }

        // Static targets configuration
        prometheus.relabel "static_targets_httproute_prober" {
          targets = []
        }

        // Scrape metrics from blackbox exporter
        prometheus.scrape "httproute_prober" {
          targets = concat(
            prometheus.exporter.blackbox.httproute_prober.targets,
            prometheus.relabel.static_targets_httproute_prober.output,
            discovery.relabel.httproutes_httproute_prober.output,
          )
          job_name = "integration/blackbox"
          params = {
            module = ["http_2xx"],
          }
          forward_to = [prometheus.relabel.httproute_prober.receiver]
        }

        prometheus.relabel "httproute_prober" {
          max_cache_size = 100000

          // Set instance label if not present
          rule {
            source_labels = ["instance"]
            regex = "^$|127\\.0\\.0\\.1:9115"
            target_label = "instance"
            replacement = "httproute-prober"
          }

          // Keep the target label for visibility
          rule {
            source_labels = ["target"]
            target_label = "target"
          }
          forward_to = argument.metrics_destinations.value
        }
      }
should handle HTTPRoute discovery with custom relabel rules:
  1: |
    |-
      declare "blackbox_integration" {
        argument "metrics_destinations" {
          comment = "Must be a list of metric destinations where collected metrics should be forwarded to"
        }


        // Create blackbox exporter
        prometheus.exporter.blackbox "custom_httproute_prober" {
          config_yaml = "modules:\n  http_2xx:\n    prober: http\n    timeout: 5s\n    http:\n      valid_http_versions: [\"HTTP/1.1\", \"HTTP/2.0\"]\n      valid_status_codes: []\n      method: GET\n"
        }
        // Discover HTTPRoute resources
        discovery.kubernetes "httproutes_custom_httproute_prober" {
          role = "httproute"
          namespaces {
            names = ["production"]
          }
        }

        // Process discovered HTTPRoutes
        discovery.relabel "httproutes_custom_httproute_prober" {
          targets = discovery.kubernetes.httproutes_custom_httproute_prober.targets

          // Keep only targets that have hostnames defined
          rule {
            source_labels = ["__meta_kubernetes_httproute_spec_hostnames"]
            regex = "\\[\\]"
            action = "drop"
          }

          // Extract hostnames array
          rule {
            source_labels = ["__meta_kubernetes_httproute_spec_hostnames"]
            regex = "\\[([^\\]]+)\\]"
            target_label = "__tmp_hostnames"
          }

          // Extract first hostname and create target URL
          // TODO: To support multiple hostnames per HTTPRoute, consider using multiple discovery instances
          rule {
            source_labels = ["__tmp_hostnames"]
            regex = "([^,\\s]+)"
            target_label = "__param_target"
            replacement = "https://${1}/api/health"
          }

          // Set module
          rule {
            target_label = "__param_module"
            replacement = "http_post_2xx"
          }

          // Set address to blackbox exporter
          rule {
            target_label = "__address__"
            replacement = "127.0.0.1:9115"
          }

          // Add metadata labels
          rule {
            source_labels = ["__meta_kubernetes_httproute_namespace"]
            target_label = "namespace"
          }

          rule {
            source_labels = ["__meta_kubernetes_httproute_name"]
            target_label = "httproute"
          }

          // Add target label for clarity
          rule {
            source_labels = ["__param_target"]
            target_label = "target"
          }
          rule {
            source_labels:
            - __meta_kubernetes_namespace_labels_environment
            target_label: environment
          }
          rule {
            regex: ([^,\s]+);(.+)
            replacement: https://${2}.${1}/api/health
            source_labels:
            - __tmp_hostnames
            - __meta_kubernetes_httproute_namespace
            target_label: __param_target
          }
        }

        // Static targets configuration
        prometheus.relabel "static_targets_custom_httproute_prober" {
          targets = []
        }

        // Scrape metrics from blackbox exporter
        prometheus.scrape "custom_httproute_prober" {
          targets = concat(
            prometheus.exporter.blackbox.custom_httproute_prober.targets,
            prometheus.relabel.static_targets_custom_httproute_prober.output,
            discovery.relabel.httproutes_custom_httproute_prober.output,
          )
          job_name = "integration/blackbox"
          params = {
            module = ["http_2xx"],
          }
          forward_to = [prometheus.relabel.custom_httproute_prober.receiver]
        }

        prometheus.relabel "custom_httproute_prober" {
          max_cache_size = 100000

          // Set instance label if not present
          rule {
            source_labels = ["instance"]
            regex = "^$|127\\.0\\.0\\.1:9115"
            target_label = "instance"
            replacement = "custom-httproute-prober"
          }

          // Keep the target label for visibility
          rule {
            source_labels = ["target"]
            target_label = "target"
          }
          forward_to = argument.metrics_destinations.value
        }
      }
